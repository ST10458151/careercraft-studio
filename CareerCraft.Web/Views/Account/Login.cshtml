@model CareerCraft.Web.Controllers.LoginForm
@{ViewData["Title"]="Customer Sign In";}
<section class="portal-wrap"><div class="portal-intro"><p class="section-kicker">WELCOME BACK</p><h1>Your career,<br/><em>in progress.</em></h1><p>Sign in to manage your documents and see where your CV request stands.</p><div class="portal-art">✳<span>A SPACE FOR WHAT'S NEXT.</span></div></div><form method="post" asp-action="Login" class="portal-card"><p class="section-kicker">ACCOUNT / ACCESS</p><h2>Sign in to your studio.</h2><div asp-validation-summary="All" class="form-errors"></div><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" placeholder="you@example.com"/><label asp-for="Password"></label><input asp-for="Password" type="password" autocomplete="current-password"/><button class="button button-dark" type="submit">Sign in ↗</button><p class="portal-switch">New here? <a asp-action="Register">Create an account</a></p></form></section>