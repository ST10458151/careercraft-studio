@model CareerCraft.Web.Controllers.RegisterForm
@{ViewData["Title"]="Create your account";}
<section class="portal-wrap"><div class="portal-intro"><p class="section-kicker">YOUR CAREERCRAFT ACCOUNT</p><h1>Begin your<br/><em>next chapter.</em></h1><p>Create your private account to submit a CV request, attach documents and keep track of your order.</p><div class="portal-art">✳<span>YOUR CAREER. CONSIDERED.</span></div></div><form method="post" asp-action="Register" class="portal-card"><p class="section-kicker">REGISTER / CUSTOMER</p><h2>Let's get acquainted.</h2><div asp-validation-summary="All" class="form-errors"></div><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" placeholder="Your full name"/><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" placeholder="you@example.com"/><label asp-for="Password"></label><input asp-for="Password" type="password" autocomplete="new-password" placeholder="Minimum 12 characters"/><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password"/><p class="small-note">This is a local development version. Email verification must be enabled before public launch.</p><button class="button button-dark" type="submit">Create account ↗</button><p class="portal-switch">Already have an account? <a asp-action="Login">Sign in</a></p></form></section>