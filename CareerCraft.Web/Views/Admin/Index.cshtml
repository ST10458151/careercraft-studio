@model CareerCraft.Web.ViewModels.AdminDashboardViewModel
@using CareerCraft.Web.Models
@{
    ViewData["Title"] = "Studio Dashboard";
    var filters = new[] {
        (Key: "all", Label: "All requests", Count: Model.Total),
        (Key: "new", Label: "New", Count: Model.New),
        (Key: "active", Label: "In progress", Count: Model.InProgress),
        (Key: "review", Label: "Client review", Count: Model.AwaitingClient),
        (Key: "completed", Label: "Completed", Count: Model.Completed)
    };
}
<section class="admin-shell">
  <div class="container">
    <div class="admin-welcome">
      <div>
        <p class="section-kicker">CAREERCRAFT STUDIO / BUSINESS WORKSPACE</p>
        <h1>Good to see you. <em>Let's get to work.</em></h1>
        <p>Your command centre for client enquiries, CV documents, revisions and delivery.</p>
      </div>
      <div class="admin-mode"><span class="mode-dot"></span> ADMIN WORKSPACE <small>LOCAL DEVELOPMENT</small></div>
    </div>
    <div class="admin-metrics" aria-label="Order overview">
      <a asp-action="Index" asp-route-filter="new" class="admin-metric">
        <div class="metric-top"><span>01 / NEW REQUESTS</span><span class="metric-symbol">✳</span></div>
        <strong>@Model.New</strong><span class="metric-foot">Needs an initial review <span>↗</span></span>
      </a>
      <a asp-action="Index" asp-route-filter="active" class="admin-metric">
        <div class="metric-top"><span>02 / IN PROGRESS</span><span class="metric-symbol">↗</span></div>
        <strong>@Model.InProgress</strong><span class="metric-foot">Being reviewed or written <span>↗</span></span>
      </a>
      <a asp-action="Index" asp-route-filter="review" class="admin-metric">
        <div class="metric-top"><span>03 / CLIENT REVIEW</span><span class="metric-symbol">✉</span></div>
        <strong>@Model.AwaitingClient</strong><span class="metric-foot">Ready for client feedback <span>↗</span></span>
      </a>
      <a asp-action="Index" asp-route-filter="completed" class="admin-metric">
        <div class="metric-top"><span>04 / COMPLETED</span><span class="metric-symbol">✓</span></div>
        <strong>@Model.Completed</strong><span class="metric-foot">Delivered or closed <span>↗</span></span>
      </a>
    </div>
    <div class="admin-notice"><span>✧</span><div><strong>Payment integration is not live.</strong> Orders are recorded as requests only. The dashboard does not charge customers, confirm payments or send automated notifications.</div></div>
    @if (TempData["Success"] is string success)
    {
        <div class="portal-success" role="status">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="form-errors" role="alert">@error</div>
    }
    <div class="admin-workspace-head">
      <div><p class="section-kicker">YOUR DAILY WORKSPACE</p><h2>Client requests <em>&amp; documents.</em></h2><p>Open a client brief to review their information, download files, and upload finished documents.</p></div>
      <div class="admin-total"><strong>@Model.Total</strong><span>TOTAL REQUESTS</span></div>
    </div>
    <div class="admin-toolbar">
      <div class="admin-tabs" aria-label="Filter requests">
        @foreach (var f in filters)
        {
            <a asp-action="Index" asp-route-filter="@f.Key" asp-route-search="@Model.Search"
               class="@(Model.Filter == f.Key ? "is-active" : "")">@f.Label <span>@f.Count</span></a>
        }
      </div>
      <form asp-action="Index" method="get" class="admin-find" role="search">
        <input type="hidden" name="filter" value="@Model.Filter" />
        <label class="sr-only" for="adminSearch">Search requests</label>
        <input id="adminSearch" name="search" value="@Model.Search" placeholder="Search customer, role or service" />
        <button type="submit" aria-label="Search requests">Search ↗</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a asp-action="Index" asp-route-filter="@Model.Filter" class="clear-search">Clear</a>
        }
      </form>
    </div>
    @if (Model.Orders.Count == 0)
    {
        <div class="admin-empty">
          <span>✳</span><h3>No requests in this view.</h3>
          <p>@(Model.Total == 0 ? "When a customer places their first CV request, it will appear here." : "Try a different filter or clear the search to see other client requests.")</p>
          <a asp-action="Index">See all requests ↗</a>
        </div>
    }
    else
    {
        <div class="admin-request-list">
          @foreach (var item in Model.Orders)
          {
              <article class="admin-request">
                <div class="request-avatar" aria-hidden="true">@(string.IsNullOrEmpty(item.CustomerEmail) ? "C" : item.CustomerEmail.Substring(0, 1).ToUpperInvariant())</div>
                <div class="request-main">
                  <div class="request-meta"><span>REQUEST #@item.Id.ToString("D5")</span><span>@item.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy")</span></div>
                  <h3>@item.ServiceName</h3>
                  <p class="request-role">Target role: <strong>@item.TargetRole</strong></p>
                  <p class="request-client">@item.CustomerEmail</p>
                  <div class="request-tags">
                    <span class="request-state @item.StatusClass">@item.StatusLabel</span>
                    <span>▤ @item.DocumentCount document@(item.DocumentCount == 1 ? "" : "s")</span>
                    <span>↺ @item.RevisionCount revision@(item.RevisionCount == 1 ? "" : "s")</span>
                    <span>R @item.PriceZar.ToString("0") quoted</span>
                  </div>
                </div>
                <div class="request-actions">
                  <a class="admin-open" asp-controller="Admin" asp-action="Details" asp-route-id="@item.Id">Open client brief <span>↗</span></a>
                  <form asp-action="ChangeStatus" method="post" class="admin-stage-form">
                    <input type="hidden" name="id" value="@item.Id" />
                    <input type="hidden" name="returnFilter" value="@Model.Filter" />
                    <input type="hidden" name="returnSearch" value="@Model.Search" />
                    <label for="stage-@item.Id">MOVE REQUEST TO</label>
                    <select name="stage" id="stage-@item.Id" aria-label="Change status for request @item.Id">
                      <option value="@((int)OrderStage.Submitted)" selected="@(item.Stage == OrderStage.Submitted)">New request</option>
                      <option value="@((int)OrderStage.InReview)" selected="@(item.Stage == OrderStage.InReview)">Reviewing details</option>
                      <option value="@((int)OrderStage.InProgress)" selected="@(item.Stage == OrderStage.InProgress)">CV in progress</option>
                      <option value="@((int)OrderStage.ReadyForReview)" selected="@(item.Stage == OrderStage.ReadyForReview)">Ready for client review</option>
                      <option value="@((int)OrderStage.Completed)" selected="@(item.Stage == OrderStage.Completed)">Completed</option>
                      <option value="@((int)OrderStage.Cancelled)" selected="@(item.Stage == OrderStage.Cancelled)">Cancelled</option>
                    </select>
                    <button type="submit">Save status ↗</button>
                  </form>
                </div>
              </article>
          }
        </div>
        @if (Model.Orders.Count == 150) { <p class="admin-limitation">Showing the 150 most recent matching requests.</p> }
    }
    <div class="admin-next">
      <div><span>✧</span><h3>How to manage an order</h3><p>Open the client brief to review their career history and attached files. Change the status as you work, upload the final CV under <strong>Final Document</strong>, then mark it ready for the client to review.</p></div>
      <div><span>▤</span><h3>Files &amp; customer privacy</h3><p>Customer documents are available within their order details, not in a public file list. Use dummy documents during development; stronger storage and scanning are required before launch.</p></div>
      <div><span>◷</span><h3>Coming next</h3><p>Verified payments, delivery notifications, revision tracking improvements and a production-ready private document service.</p></div>
    </div>
  </div>
</section>