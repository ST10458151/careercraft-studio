@model IReadOnlyList<CvOrder>
@{ViewData["Title"]="Admin Dashboard";}
<section class="inner-hero portal-heading"><div class="container"><p class="section-kicker">PRIVATE / STUDIO MANAGEMENT</p><h1>The studio <em>dashboard.</em></h1><p>Manage CV requests, track customer progress and review their attached documents.</p></div></section>
<section class="section"><div class="container"><div class="dashboard-head"><div><p class="section-kicker">ORDER MANAGEMENT</p><h2>Client requests.</h2></div><form method="get" class="admin-search"><input name="search" value="@Context.Request.Query["search"]" placeholder="Search roles or services"/><button class="button button-dark">Search ↗</button></form></div><div class="overview-boxes"><div><small>TOTAL REQUESTS</small><strong>@ViewBag.Total</strong></div><div><small>ACTIVE REQUESTS</small><strong>@ViewBag.Active</strong></div><div><small>UNPAID (CHECKOUT DISABLED)</small><strong>@ViewBag.Unpaid</strong></div></div>
<div class="admin-orders">@if(Model.Count==0){<div class="portal-empty">No requests found.</div>}@foreach(var item in Model){<article class="admin-order"><div class="admin-order-info"><p class="section-kicker">REQUEST #@item.Id.ToString("D5") · @item.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy")</p><h3>@item.ServiceName · @item.TargetRole</h3><p>R @item.PriceZar.ToString("0") · @(item.IsPaid?"Paid":"Payment not collected") · @item.Documents.Count document(s) · @item.Revisions.Count revision(s)</p><a asp-controller="Orders" asp-action="Details" asp-route-id="@item.Id">Review brief &amp; documents ↗</a></div><form asp-action="ChangeStatus" method="post" class="status-editor"><input type="hidden" name="id" value="@item.Id"/><label for="status-@item.Id">Update status</label><select id="status-@item.Id" name="stage" asp-items="Html.GetEnumSelectList<OrderStage>()"><option value="@((int)item.Stage)" selected disabled>Current: @item.Stage</option></select><button type="submit">Save status ↗</button></form></article>}</div></div></section>