@model IReadOnlyList<OrderDocument>
@{ViewData["Title"]="My Documents";}
<section class="inner-hero portal-heading"><div class="container"><p class="section-kicker">PRIVATE FILES</p><h1>My <em>documents.</em></h1><p>Your existing CVs, supporting documents, job descriptions and completed files, grouped by CV request.</p></div></section><section class="section"><div class="container"><div class="dashboard-head"><h2>Files in your studio.</h2><a class="button button-dark" asp-controller="Orders" asp-action="Index">My orders ↗</a></div>@if(Model.Count==0){<div class="portal-empty"><span>▤</span><h3>No documents yet.</h3><p>Open a CV request to upload your current CV or other documents.</p><a class="button button-dark" asp-controller="Orders" asp-action="Index">Go to my orders</a></div>}else{<div class="portal-card file-list">@foreach(var d in Model){<div class="file-row"><div><strong>@d.OriginalName</strong><small>Request #@d.OrderId · @d.Kind · @d.UploadedUtc.ToLocalTime().ToString("dd MMM yyyy")</small></div><a asp-action="Download" asp-route-id="@d.Id">Download ↗</a><a asp-controller="Orders" asp-action="Details" asp-route-id="@d.OrderId">View order ↗</a></div>}</div>}</div></section>