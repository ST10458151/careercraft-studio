@model IReadOnlyList<ServiceOffering>
@{ ViewData["Title"] = "Services & Pricing"; }
<section class="inner-hero"><div class="container"><p class="section-kicker">SERVICES / CLEAR PRICING</p><h1>Find the right words<br />for your <em>next chapter.</em></h1><p>Explore straightforward options for refreshing, rewriting and presenting your professional story.</p></div></section>
<section class="section services-section"><div class="container"><div class="service-detail-grid">@foreach(var item in Model){<article class="service-detail @item.Accent"><div class="detail-top"><span>CAREERCRAFT SERVICE</span><span>✳</span></div><h2>@item.Name</h2><p>@item.Details</p><div class="detail-meta"><div><small>PRICE</small><strong>R @item.Price.ToString("0")</strong></div><div><small>INDICATIVE TIMELINE</small><strong>@item.Timeline</strong></div></div><a class="button button-dark" asp-action="Request" asp-route-service="@item.Slug">Enquire about this service ↗</a></article>}</div><div class="notice-panel"><strong>BEFORE YOU ORDER</strong><p>These are draft launch prices. Your deliverables, turnaround time and any revisions will be clearly agreed before work begins. This first release does not accept payments or documents online.</p></div></div></section>
