@model CvOrder
@{
 ViewData["Title"]="My request";
 var uploads=Model.Documents.Where(x=>x.Kind!=DocumentKind.FinalDocument).OrderByDescending(x=>x.UploadedUtc).ToList();
 var finals=Model.Documents.Where(x=>x.Kind==DocumentKind.FinalDocument).OrderByDescending(x=>x.UploadedUtc).ToList();
 var progress=Model.Stage switch{OrderStage.Submitted=>1,OrderStage.InReview=>2,OrderStage.InProgress=>2,OrderStage.ReadyForReview=>3,OrderStage.Completed=>4,_=>0};
 var stage=Model.Stage switch{OrderStage.Submitted=>"Request received",OrderStage.InReview=>"Reviewing your request",OrderStage.InProgress=>"Documents in preparation",OrderStage.ReadyForReview=>"Ready for your review",OrderStage.Completed=>"Completed",_=>"Cancelled"};
}
<section class="client-workspace"><div class="container">
<a class="workspace-back" asp-action="Index">← Back to my requests</a>
<div class="workspace-top"><div><p class="section-kicker">MY REQUEST #@Model.Id.ToString("D5")</p><h1>@Model.ServiceName</h1><p>Prepared for your next role as <b>@Model.TargetRole</b></p></div><div class="workspace-price"><small>SELECTED PACKAGE</small><strong>R @Model.PriceZar.ToString("0")</strong><span>No payment collected</span></div></div>
@if(TempData["Success"] is string success){<div class="portal-success">@success</div>}
@if(TempData["Error"] is string error){<div class="form-errors">@error</div>}
<div class="customer-progress"><div><small>REQUEST PROGRESS</small><strong>@stage</strong></div><div class="progress-steps">@foreach(var s in new[]{(n:1,t:"Received"),(n:2,t:"In preparation"),(n:3,t:"Your review"),(n:4,t:"Completed")}){<div class="@(progress>=s.n?"is-done":"")"><span>@(progress>s.n?"✓":s.n.ToString())</span><small>@s.t</small></div>}</div></div>
<nav class="workspace-jump"><a href="#my-files">01 My uploads</a><a href="#my-deliveries">02 Finished documents</a><a href="#my-brief">03 My career details</a><a href="#my-feedback">04 Feedback</a></nav>
<div class="customer-work-grid"><div>
<section class="workspace-panel" id="my-files"><div class="workspace-panel-title"><span>01 / SUPPORTING DOCUMENTS</span><h2>My uploaded documents</h2><p>Add your current CV, cover letter, certificates or any job description you want us to consider.</p></div>
<form asp-controller="Documents" asp-action="Upload" method="post" enctype="multipart/form-data" class="workspace-upload"><input type="hidden" name="orderId" value="@Model.Id"/><label for="fileKind">Document type</label><select id="fileKind" name="kind"><option value="0">My current CV</option><option value="1">Cover letter</option><option value="2">Qualifications / certificates</option><option value="3">Job description</option><option value="4">Other document</option></select><label for="supportingFile">PDF or DOCX, maximum 8 MB</label><input id="supportingFile" name="file" type="file" accept=".pdf,.docx" required/><button type="submit">Add document ↗</button></form>
@if(uploads.Count==0){<p class="workspace-placeholder">You haven't uploaded any supporting files yet.</p>}else{<div class="workspace-files">@foreach(var doc in uploads){<div><span class="file-illustration">▤</span><div><b>@doc.OriginalName</b><small>@doc.Kind · @Math.Ceiling(doc.SizeBytes/1024d) KB</small></div><a asp-controller="Documents" asp-action="Download" asp-route-id="@doc.Id">Download</a><form asp-controller="Documents" asp-action="Delete" asp-route-id="@doc.Id" method="post"><button type="submit" class="quiet-remove">Remove</button></form></div>}</div>}</section>
<section class="workspace-panel" id="my-deliveries"><div class="workspace-panel-title"><span>02 / FINISHED WORK</span><h2>Your completed documents</h2><p>Your new CV or letter will be available here when marked ready.</p></div>
@if(finals.Count==0||!(Model.Stage==OrderStage.ReadyForReview||Model.Stage==OrderStage.Completed)){<p class="workspace-placeholder">Nothing is ready to download yet. You can check your progress above.</p>}else{<div class="workspace-files">@foreach(var doc in finals){<div><span class="file-illustration">✓</span><div><b>@doc.OriginalName</b><small>Ready for download</small></div><a asp-controller="Documents" asp-action="Download" asp-route-id="@doc.Id">Download ↗</a></div>}</div>}</section>
<section class="workspace-panel" id="my-brief"><div class="workspace-panel-title"><span>03 / DETAILS YOU SUBMITTED</span><h2>My career information</h2><p>Review the information used for your request.</p></div><details class="career-details"><summary>Show my submitted information ＋</summary><div class="workspace-fields">
@foreach(var field in new (string Name,string? Value)[]{("Target role",Model.TargetRole),("Industry",Model.Industry),("Education",Model.Education),("Experience",Model.Experience),("Achievements",Model.Achievements),("Skills",Model.Skills),("Career goals",Model.CareerGoals),("Vacancy links",Model.JobLinks),("Job description",Model.JobDescription)}){<div><strong>@field.Name</strong><p>@(string.IsNullOrWhiteSpace(field.Value)?"Not provided":field.Value)</p></div>}
</div></details></section>
<section class="workspace-panel" id="my-feedback"><div class="workspace-panel-title"><span>04 / REVIEW & FEEDBACK</span><h2>Revisions</h2><p>Request changes after your draft is ready.</p></div>
@foreach(var rev in Model.Revisions.OrderByDescending(x=>x.CreatedUtc)){<div class="revision-entry"><b>@rev.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy")</b><span>@rev.Message</span></div>}
@if(Model.Stage==OrderStage.ReadyForReview){<form asp-action="Revision" asp-route-id="@Model.Id" method="post" class="workspace-upload"><label for="revisionMessage">What would you like changed?</label><textarea id="revisionMessage" name="message" rows="4" maxlength="2000" required></textarea><button type="submit">Send revision request ↗</button></form>}else{<p class="workspace-placeholder">You can send revisions once your draft is ready for review.</p>}</section></div>
<aside><section class="workspace-panel workspace-aside"><span class="section-kicker">YOUR ORDER AT A GLANCE</span><h2>What's next?</h2><p>Your request is currently <b>@stage</b>. Upload any documents that will help us understand your career background.</p><div class="stage-help"><p><b>Reference</b> #@Model.Id.ToString("D5")</p><p><b>Submitted</b> @Model.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy")</p><p><b>Service</b> @Model.ServiceName</p></div></section></aside></div>
</div></section>