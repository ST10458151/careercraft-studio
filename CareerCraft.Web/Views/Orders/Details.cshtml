@model CvOrder
@{ViewData["Title"]="Request #"+Model.Id;var isAdmin=User.IsInRole("Admin");}
<section class="inner-hero portal-heading"><div class="container"><p class="section-kicker">PRIVATE CAREER DASHBOARD / REQUEST #@Model.Id.ToString("D5")</p><h1>@Model.ServiceName<br/><em>in progress.</em></h1><p>Target position: @Model.TargetRole</p></div></section>
<section class="section"><div class="container order-details"><div class="dashboard-head"><div><p class="section-kicker">ORDER OVERVIEW</p><h2>Your request at a glance.</h2></div><a class="text-link" asp-action="Index">← All my orders</a></div>
@if(TempData["Success"] is string success){<div class="portal-success" role="status">@success</div>}
@if(TempData["Error"] is string error){<div class="form-errors" role="alert">@error</div>}
<div class="overview-boxes"><div><small>REQUEST STATUS</small><strong>@Model.Stage.ToString()</strong></div><div><small>SELECTED SERVICE</small><strong>@Model.ServiceName</strong></div><div><small>PRICE (ZAR)</small><strong>R @Model.PriceZar.ToString("0")</strong></div><div><small>PAYMENT</small><strong>@(Model.IsPaid?"Verified paid":"Not available yet")</strong></div></div>
<div class="detail-columns"><div class="portal-card documents-panel"><p class="section-kicker">MY DOCUMENTS / PRIVATE UPLOADS</p><h2>Your current files.</h2><p>Upload your existing CV, cover letter, qualifications or job descriptions. These files are stored outside the public website directory.</p>
<form asp-controller="Documents" asp-action="Upload" method="post" enctype="multipart/form-data" class="document-upload"><input type="hidden" name="orderId" value="@Model.Id"/><label for="kind">Document category</label><select id="kind" name="kind" asp-items="Html.GetEnumSelectList<DocumentKind>()"></select><label for="file">Choose PDF or Word document (max 8 MB)</label><input type="file" id="file" name="file" accept=".pdf,.docx" required/><button class="button button-dark" type="submit">Upload document ↗</button></form>
@if(Model.Documents.Count==0){<div class="empty-docs">✧ No documents uploaded for this request yet.</div>}else{<div class="file-list">@foreach(var doc in Model.Documents.OrderByDescending(x=>x.UploadedUtc)){<div class="file-row"><div><strong>@doc.OriginalName</strong><small>@doc.Kind · @(Math.Round(doc.SizeBytes/1024d)) KB · @doc.UploadedUtc.ToLocalTime().ToString("dd MMM yyyy")</small></div><a asp-controller="Documents" asp-action="Download" asp-route-id="@doc.Id">Download ↗</a>@if(!doc.UploadedByAdmin||isAdmin){<form asp-controller="Documents" asp-action="Delete" asp-route-id="@doc.Id" method="post"><button type="submit" aria-label="Delete @doc.OriginalName">Remove</button></form>}</div>}</div>}
<a asp-controller="Documents" asp-action="Index" asp-route-orderId="@Model.Id" class="text-link">Open My Documents ↗</a></div>
<aside class="portal-card order-brief"><p class="section-kicker">YOUR CAREER BRIEF</p><h2>What we're working towards.</h2><dl><dt>Target role</dt><dd>@Model.TargetRole</dd><dt>Industry</dt><dd>@(Model.Industry??"Not supplied")</dd><dt>Education</dt><dd>@(Model.Education??"Not supplied")</dd><dt>Experience</dt><dd>@(Model.Experience??"Not supplied")</dd><dt>Key achievements</dt><dd>@(Model.Achievements??"Not supplied")</dd><dt>Skills</dt><dd>@(Model.Skills??"Not supplied")</dd><dt>Career goals</dt><dd>@(Model.CareerGoals??"Not supplied")</dd><dt>Target vacancy links</dt><dd>@(Model.JobLinks??"Not supplied")</dd><dt>Job description</dt><dd>@(Model.JobDescription??"Not supplied")</dd></dl></aside></div>
<div class="portal-card revision-panel"><p class="section-kicker">FEEDBACK / REVISIONS</p><h2>Revision requests.</h2>@if(Model.Revisions.Count>0){@foreach(var rev in Model.Revisions.OrderByDescending(x=>x.CreatedUtc)){<p class="revision-entry"><b>@rev.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy")</b><span>@rev.Message</span></p>}}else{<p>No revision requests have been submitted.</p>}
@if(!isAdmin&&Model.Stage==OrderStage.ReadyForReview){<form asp-action="Revision" asp-route-id="@Model.Id" method="post"><label for="message">Your feedback</label><textarea name="message" id="message" maxlength="2000" required rows="4"></textarea><button type="submit" class="button button-dark">Request revision ↗</button></form>}else if(!isAdmin){<p class="small-note">Revision requests become available once your document is marked Ready for Review.</p>}</div>
</div></section>