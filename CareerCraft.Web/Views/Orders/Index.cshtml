@model IReadOnlyList<CvOrder>
@{ViewData["Title"]="My Orders";}
<section class="inner-hero portal-heading"><div class="container"><p class="section-kicker">YOUR PRIVATE STUDIO</p><h1>Every next step,<br/><em>in one place.</em></h1><p>View your CV requests, upload supporting documents and keep track of each order.</p></div></section><section class="section"><div class="container"><div class="dashboard-head"><div><p class="section-kicker">MY ORDERS</p><h2>Your career documents.</h2></div><a class="button button-dark" asp-action="Create">＋ New CV request</a></div>@if(Model.Count==0){<div class="portal-empty"><span>✳</span><h3>Your next chapter starts here.</h3><p>You haven't created a CV request yet. Choose a service and tell us about the jobs you're aiming for.</p><a class="button button-dark" asp-action="Create">Create first request ↗</a></div>}else{<div class="order-grid">@foreach(var item in Model){<article class="order-card"><p class="section-kicker">REQUEST #@item.Id.ToString("D5")</p><h3>@item.ServiceName</h3><p>Target role: <strong>@item.TargetRole</strong></p><div class="order-card-meta"><span class="status-pill">@item.Stage.ToString()</span><span>R @item.PriceZar.ToString("0") · @(item.IsPaid?"Paid":"Payment pending")</span></div><a asp-action="Details" asp-route-id="@item.Id">Open request &amp; documents ↗</a></article>}</div>}</div></section>