@model IReadOnlyList<CvOrder>
@{ViewData["Title"]="My requests";}
<section class="client-workspace"><div class="container"><div class="workspace-top"><div><p class="section-kicker">YOUR PERSONAL CAREER SPACE</p><h1>My requests.</h1><p>View your active CV services, documents and progress in one place.</p></div><a asp-action="Create" class="button button-dark">＋ New CV request</a></div>
@if(Model.Count==0){<div class="workspace-panel"><h2>Your next chapter starts here.</h2><p>Choose a service and submit your career details to begin.</p><a class="button button-dark" asp-action="Create">Start first request ↗</a></div>}
else{<div class="my-requests">@foreach(var item in Model){<article class="my-request-card"><div class="my-card-top"><span>REQUEST #@item.Id.ToString("D5")</span><span>@item.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy")</span></div><h2>@item.ServiceName</h2><p>Target role: <b>@item.TargetRole</b></p><div class="my-card-footer"><span>@item.Stage.ToString()</span><a asp-action="Details" asp-route-id="@item.Id">View details &amp; files ↗</a></div></article>}</div>}
</div></section>