<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] | CareerCraft Studio</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet"/><link rel="stylesheet" href="~/css/studio.css" asp-append-version="true"/></head><body class="@(User.IsInRole("Admin")?"admin-context":"")">
@if(User.IsInRole("Admin")) {
<header class="studio-admin-header"><div class="container studio-admin-bar"><a class="studio-admin-brand" asp-controller="Admin" asp-action="Index">✳ <span>careercraft <small>STUDIO ADMINISTRATION</small></span></a><nav class="studio-admin-nav" aria-label="Admin navigation"><a asp-controller="Admin" asp-action="Index">All client requests</a><a asp-controller="Admin" asp-action="Index" asp-route-filter="new">New</a><a asp-controller="Admin" asp-action="Index" asp-route-filter="active">In progress</a><a asp-controller="Admin" asp-action="Index" asp-route-filter="review">Client review</a><a asp-controller="Admin" asp-action="Index" asp-route-filter="completed">Completed</a></nav><div class="admin-header-end"><span>ADMIN MODE</span><form asp-controller="Account" asp-action="Logout" method="post"><button>Sign out ↗</button></form></div></div></header>
} else {
<div class="announcement">YOUR NEXT CHAPTER, THOUGHTFULLY CRAFTED ✦ PROFESSIONAL CV &amp; CAREER SERVICES</div>
<header class="site-header"><div class="nav-wrap"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-symbol">c<span>✳</span></span><span class="brand-text">careercraft<small>STUDIO</small></span></a><nav id="siteNav" class="site-nav" aria-label="Main navigation"><a asp-controller="Home" asp-action="Index">Home</a><a asp-controller="Home" asp-action="Services">Services</a>@if(User.Identity?.IsAuthenticated==true){<a asp-controller="Orders" asp-action="Index">My requests</a><a asp-controller="Documents" asp-action="Index">My documents</a>}else{<a asp-controller="Home" asp-action="Index" asp-fragment="how">How it works</a><a asp-controller="Home" asp-action="Index" asp-fragment="faq">FAQs</a>}</nav>@if(User.Identity?.IsAuthenticated==true){<form class="nav-logout" asp-controller="Account" asp-action="Logout" method="post"><button>Sign out ↗</button></form>}else{<a class="nav-cta" asp-controller="Account" asp-action="Login">Sign in ↗</a>}<button id="menuButton" class="menu-button" aria-controls="siteNav" aria-expanded="false">☰</button></div></header>
}
<main>@RenderBody()</main>
@if(!User.IsInRole("Admin")){<footer class="footer"><div class="container footer-top"><div><div class="footer-brand">careercraft<span>✳</span></div><p>Better documents. Stronger first impressions.</p></div><div><strong>EXPLORE</strong><a asp-controller="Home" asp-action="Index">Home</a><a asp-controller="Home" asp-action="Services">Services</a><a asp-controller="Orders" asp-action="Create">Start a request</a></div><div><strong>INFORMATION</strong><a asp-controller="Home" asp-action="Privacy">Privacy</a><a href="mailto:s.khan0701@icloud.com">Contact</a></div></div><div class="container footer-bottom">© <span id="year">2026</span> CareerCraft Studio</div></footer>}
<script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>